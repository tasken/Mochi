# Dev server certificate (generated locally)
.cert/

# Local notes and research
.local/

# Runtime
*.log
__pycache__/

# Python environment
.venv/

# Local firmware reference clone (not deployed, not committed)
upstream/

# Build-time firmware downloads (fetched by fetch-firmware.sh)
app/firmware/

# Personal dev task config (contains local IP, ports, etc.)
tasks.py

# Benchmark tool working copy (not deployed to GitHub Pages; tracked source
# lives in netlify/bench/ and is copied in by the Netlify build)
app/bench.html
app/bench.js

# Environment config (server-specific values)
.env
